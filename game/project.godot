; Engine configuration for the initial simulation foundation.
config_version=5

[application]
config/name="The Free Game"
; Keep the original save directory after the public-facing project rename.
config/use_custom_user_dir=true
config/custom_user_dir_name="godot/app_userdata/Vale dos Vinhedos - Vila Viva"
config/custom_user_dir_name.macos="Godot/app_userdata/Vale dos Vinhedos - Vila Viva"
config/custom_user_dir_name.windows="Godot/app_userdata/Vale dos Vinhedos - Vila Viva"
config/icon="res://assets/icon.svg"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.16, 0.23, 0.21, 1)
run/main_scene="res://scenes/approved.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/version="0.4.4"

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="disabled"
window/handheld/orientation=0

[rendering]
lights_and_shadows/directional_shadow/size=4096
textures/default_filters/anisotropic_filtering_level=3
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.075, 0.15, 0.14, 1)

[simulation]
fixed_step_usec=100000


[input_devices]
pointing/emulate_mouse_from_touch=true

[audio]
general/default_playback_type.web=1
