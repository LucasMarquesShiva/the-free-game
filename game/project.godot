; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="The Free Game"
config/version="0.4.4"
run/main_scene="res://scenes/approved.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="godot/app_userdata/Vale dos Vinhedos - Vila Viva"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.16, 0.23, 0.21, 1)
boot_splash/show_image=false
config/icon="res://assets/icon.svg"
config/custom_user_dir_name.macos="Godot/app_userdata/Vale dos Vinhedos - Vila Viva"
config/custom_user_dir_name.windows="Godot/app_userdata/Vale dos Vinhedos - Vila Viva"

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900

[importer_defaults]

texture={
"compress/mode": 2
}

[internationalization]

locale/fallback="pt_BR"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/anisotropic_filtering_level=3
environment/defaults/default_clear_color=Color(0.075, 0.15, 0.14, 1)

[simulation]

fixed_step_usec=100000
